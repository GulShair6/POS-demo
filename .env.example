# ---------------------------------------------------------------------------
# Docker Compose (self-hosted)
# ---------------------------------------------------------------------------
# Application talks to the Compose `db` service on the internal network.
DATABASE_URL=postgres://atlas:replace-with-a-long-database-password@db:5432/atlas_pos
POSTGRES_DB=atlas_pos
POSTGRES_USER=atlas
POSTGRES_PASSWORD=replace-with-a-long-database-password
DB_POOL_SIZE=10
# DATABASE_PREPARE=true

# ---------------------------------------------------------------------------
# Vercel + Supabase (demo / serverless)
# ---------------------------------------------------------------------------
# Runtime DATABASE_URL must be the Supabase Transaction pooler (port 6543), e.g.
# postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations/seed should use the Direct (or Session pooler) URL:
# DIRECT_DATABASE_URL=postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# On Vercel set:
#   DATABASE_URL=<transaction pooler 6543>
#   DB_POOL_SIZE=1
#   DATABASE_PREPARE=false
#   DATABASE_SSL=true
#   SEED_DEMO_DATA=false

# Initial owner. The account is created once and is not overwritten on restart.
ADMIN_NAME=Atlas Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Store configuration. Tax is expressed as a decimal: 0.0825 = 8.25%.
POS_BUSINESS_NAME=Atlas Coffee
POS_STORE_NAME=Downtown store
POS_REGISTER_CODE=REG-01
POS_CURRENCY=USD
POS_LOCALE=en-US
POS_TAX_RATE=0.0825

# Set true only when you want sample products and customers on first boot.
SEED_DEMO_DATA=false
